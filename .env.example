# Copy to .env (repo root or api/). Every value is optional for the M0 stubs.
ANTHROPIC_API_KEY=
MODEL_COMPILE=claude-sonnet-5-5
MODEL_JUDGE=claude-sonnet-5-5
MODEL_PARSE=claude-haiku-4-5
MODEL_CLOSER=claude-sonnet-5-5
# USD per MTok (input, output) per model id; JSON. Default covers the Claude 4.5-5.5 models.
# MODEL_PRICES={"claude-sonnet-4-5": [3.0, 15.0]}
# off | replay. replay: /api/match and /api/closer re-emit the runs `make record-demo` recorded.
DEMO_MODE=off
# DEMO_FIXTURES_DIR=/absolute/path/to/runs   (default: data/fixtures/runs)
# DEMO_REPLAY_MAX_GAP_S=0.2   (longest wait between replayed trace events)
# DATABASE_URL=sqlite:////absolute/path/app.db   (default: api/app.db)
# Session cookie Secure flag (default true). `make dev` / `make api` pass false for http://localhost.
# SESSION_COOKIE_SECURE=false
# Proxies (CIDR, JSON list) whose X-Forwarded-For the sign-in throttle believes. Default: loopback.
# TRUSTED_PROXIES=["127.0.0.0/8", "::1/128"]
# Passkeys: the WebAuthn relying-party ID (the domain passkeys are bound to) and the page origin.
# Defaults are for `make dev`; compose.yaml sets prod's. Use localhost, not 127.0.0.1, in dev.
# WEBAUTHN_RP_ID=localhost
# WEBAUTHN_ORIGIN=http://localhost:3045
# Email (Resend). Without RESEND_API_KEY every email is logged instead of sent.
RESEND_API_KEY=
# EMAIL_FROM=TrialMatch Rx <noreply@crimsoncowlabs.com>
# EMAIL_REPLY_TO=aaron@crimsoncowlabs.com
# Where each new request-access submission is emailed; unset sends none. compose.yaml sets prod's.
# ADMIN_NOTIFY_EMAIL=aaron@crimsoncowlabs.com
# CORS origins for the web app (JSON list); add yours when running web on another port.
# CORS_ORIGINS=["http://localhost:3045", "http://127.0.0.1:3045"]
# Web (put this one in web/.env.local; Next only reads env files in web/). Default shown.
NEXT_PUBLIC_API_URL=http://localhost:8045
