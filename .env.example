# Copy to .env (repo root or api/). Every value is optional for the M0 stubs.
ANTHROPIC_API_KEY=
MODEL_COMPILE=claude-sonnet-4-5
MODEL_JUDGE=claude-sonnet-4-5
MODEL_PARSE=claude-haiku-4-5
MODEL_CLOSER=claude-sonnet-4-5
# off | replay
DEMO_MODE=off
# DATABASE_URL=sqlite:////absolute/path/app.db   (default: api/app.db)
# Web (put this one in web/.env.local; Next only reads env files in web/). Default shown.
NEXT_PUBLIC_API_URL=http://localhost:8000
